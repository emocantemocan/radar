<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Gemini asistan">
        <EditTextPreference
            app:key="gemini_api_key"
            app:dialogLayout="@layout/pref_dialog_secret"
            app:title="Gemini API anahtarı" />
        <Preference
            app:key="help_gemini"
            app:title="Gemini anahtarı nasıl alınır?"
            app:summary="aistudio.google.com/apikey → Google hesabınla gir → Create API key → anahtarı kopyala. Ücretsiz katman yeterli.">
            <intent android:action="android.intent.action.VIEW" android:data="https://aistudio.google.com/apikey" />
        </Preference>
        <ListPreference
            app:key="persona"
            app:title="Konuşma tarzı (argo dozu)"
            app:defaultValue="sert"
            app:entries="@array/persona_titles"
            app:entryValues="@array/persona_values"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            app:key="gemini_voice"
            app:title="Asistan sesi"
            app:defaultValue="Puck"
            app:entries="@array/voice_titles"
            app:entryValues="@array/voice_values"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="gemini_warnings"
            app:title="Radar uyarılarını Gemini üretsin"
            app:summary="Kapalıysa ya da Gemini 2,5 sn içinde cevap vermezse düz uyarı okunur"
            app:defaultValue="true" />
        <EditTextPreference
            app:key="gemini_live_model"
            app:title="Sesli sohbet (Live) modeli"
            app:defaultValue="gemini-2.5-flash-native-audio-preview-09-2025"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="gemini_text_model"
            app:title="Uyarı metni modeli"
            app:defaultValue="gemini-flash-latest"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Rota">
        <ListPreference
            app:key="routing_provider"
            app:title="Rota servisi"
            app:defaultValue="osrm"
            app:entries="@array/routing_titles"
            app:entryValues="@array/routing_values"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="osrm_url"
            app:title="OSRM sunucu adresi"
            app:defaultValue="https://router.project-osrm.org"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="graphhopper_key"
            app:dialogLayout="@layout/pref_dialog_secret"
            app:title="GraphHopper API anahtarı" />
        <Preference
            app:key="help_graphhopper"
            app:title="GraphHopper anahtarı nasıl alınır?"
            app:summary="graphhopper.com → Sign up (ücretsiz) → Dashboard → API Keys → Add API Key. Günde 500 rota ücretsiz.">
            <intent android:action="android.intent.action.VIEW" android:data="https://graphhopper.com/dashboard/signup" />
        </Preference>
        <EditTextPreference
            app:key="google_key"
            app:dialogLayout="@layout/pref_dialog_secret"
            app:title="Google Maps API anahtarı" />
        <Preference
            app:key="help_google"
            app:title="Google Maps anahtarı nasıl alınır?"
            app:summary="console.cloud.google.com → proje oluştur → faturalandırmayı etkinleştir → Directions API'yi etkinleştir → Kimlik bilgileri → API anahtarı oluştur. Ayrıntılar README'de.">
            <intent android:action="android.intent.action.VIEW" android:data="https://console.cloud.google.com/google/maps-apis/credentials" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory app:title="Sesli uyarılar">
        <SwitchPreferenceCompat
            app:key="radar_alerts"
            app:title="Radar ve koridor uyarıları"
            app:summary="2 km ve 500 m kala uyarır"
            app:defaultValue="true" />
        <SwitchPreferenceCompat
            app:key="active_only"
            app:title="Yalnızca aktif radarlar"
            app:summary="Kapalıyken bakanlık verisinde pasif görünen radarlar da soluk gösterilir ve uyarılır"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="voice_guidance"
            app:title="Sesli yol tarifi"
            app:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Harita">
        <ListPreference
            app:key="map_provider"
            app:title="Harita"
            app:defaultValue="vector"
            app:entries="@array/map_titles"
            app:entryValues="@array/map_values"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="map_style_url"
            app:title="Vektör stil adresi"
            app:summary="MapLibre/Mapbox uyumlu style.json adresi (anahtar gerekiyorsa adrese ekleyin)" />
        <EditTextPreference
            app:key="carto_key"
            app:dialogLayout="@layout/pref_dialog_secret"
            app:title="CARTO API anahtarı" />
        <Preference
            app:key="help_carto"
            app:title="CARTO anahtarı nasıl alınır?"
            app:summary="carto.com → ücretsiz hesap aç → Developers / Credentials → API Access Token oluştur → buraya yapıştır.">
            <intent android:action="android.intent.action.VIEW" android:data="https://app.carto.com/" />
        </Preference>
        <EditTextPreference
            app:key="carto_url"
            app:title="CARTO karo adresi"
            app:defaultValue="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png?api_key={key}"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            app:key="tile_url"
            app:title="Özel karo adresi"
            app:defaultValue="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            app:key="dark_map"
            app:title="Özel haritayı koyulaştır"
            app:summary="Özel adres açık renkli bir haritaysa cihazda gece görünümüne çevirir"
            app:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Test">
        <SwitchPreferenceCompat
            app:key="simulate"
            app:title="Sürüş simülasyonu"
            app:summary="Navigasyon başlayınca araç rotada sanal olarak ilerler (evde uyarıları denemek için)"
            app:defaultValue="false" />
        <EditTextPreference
            app:key="sim_speed"
            app:title="Simülasyon hızı (km/s)"
            app:defaultValue="100"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Tanılama">
        <Preference
            app:key="test_ministry"
            app:title="Radar servisini test et"
            app:summary="İçişleri Bakanlığı radar servisine bağlanıp il, ilçe ve radar sorgusunu dener; hata varsa ayrıntısını gösterir" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Hakkında">
        <Preference
            app:key="about"
            app:title="Veri kaynağı"
            app:summary="Radar ve hız koridoru verileri: T.C. İçişleri Bakanlığı. Harita: © OpenStreetMap katkıcıları. Uyarılar bilgilendirme amaçlıdır; trafik kurallarına uymak sürücünün sorumluluğundadır." />
    </PreferenceCategory>
</PreferenceScreen>
