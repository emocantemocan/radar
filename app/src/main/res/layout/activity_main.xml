<?xml version="1.0" encoding="utf-8"?>
<!-- "Gece sürüşü yol levhası" tasarımı -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:maplibre_uiAttribution="true"
        app:maplibre_uiLogo="false"
        app:maplibre_uiCompass="false"
        app:maplibre_renderTextureMode="false" />

    <!-- ============ Üst: arama + son hedef çipleri ============ -->
    <LinearLayout
        android:id="@+id/searchGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/searchButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Ara"
                    android:src="@drawable/ic_navigation"
                    app:tint="@color/link" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_soft" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/recentScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/recentChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ============ Üst: manevra bandı (navigasyon) ============ -->
    <LinearLayout
        android:id="@+id/maneuverCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_banner"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/maneuverIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="Manevra"
            android:src="@drawable/ic_m_straight" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/maneuverDistance"
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="40sp"
                tools:text="300 m" />

            <TextView
                android:id="@+id/maneuverText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Sağa dönün, Atatürk Bulvarı" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Sol: hız ve hız sınırı levhası ============ -->
    <LinearLayout
        android:id="@+id/speedPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="150dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_speed_box"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/speedText"
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="44sp"
                tools:text="94" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/sa"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speedSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                tools:text="GPS hızı" />
        </LinearLayout>

        <TextView
            android:id="@+id/limitBadge"
            style="@style/Text.Display"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_limit"
            android:gravity="center"
            android:textColor="#FF111111"
            android:textSize="26sp"
            android:visibility="gone"
            tools:text="82" />
    </LinearLayout>

    <!-- ============ Sağ: konumum + Gemini ============ -->
    <LinearLayout
        android:id="@+id/fabColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="220dp"
        android:gravity="end"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/reportFab"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_circle_surface"
            android:contentDescription="Burada seyyar radar var (basılı tut: sil)"
            android:src="@drawable/ic_radar"
            app:tint="@color/text_soft" />

        <ImageButton
            android:id="@+id/recenterFab"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_surface"
            android:contentDescription="Konumuma git"
            android:src="@drawable/ic_my_location"
            app:tint="@color/text_soft" />

        <ImageButton
            android:id="@+id/micFab"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle_brand"
            android:contentDescription="Gemini asistanı başlat"
            android:elevation="8dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/text" />
    </LinearLayout>

    <!-- ============ Radar uyarı kartı (navigasyon) ============ -->
    <LinearLayout
        android:id="@+id/alertCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="100dp"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/alertLimit"
                style="@style/Text.Display"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_limit"
                android:gravity="center"
                android:textColor="#FF111111"
                android:textSize="22sp"
                tools:text="82" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/alertKind"
                        style="@style/Text.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/sev3_label"
                        tools:text="RADAR · SERT ARGO" />

                    <TextView
                        android:id="@+id/alertDistance"
                        style="@style/Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        tools:text="500 m" />
                </LinearLayout>

                <TextView
                    android:id="@+id/alertText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.1"
                    android:maxLines="3"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    tools:text="Abi gaza gelme, 500 metre sonra radar var, sınır 82! Ayağını kaldır koçum." />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 4 kademeli sertlik göstergesi: dolu çubuk sayısı = kademe -->
            <LinearLayout
                android:id="@+id/severityBars"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:gravity="bottom"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_sev_bar" />
                <View android:layout_width="8dp" android:layout_height="12dp" android:layout_marginStart="4dp" android:background="@drawable/bg_sev_bar" />
                <View android:layout_width="8dp" android:layout_height="17dp" android:layout_marginStart="4dp" android:background="@drawable/bg_sev_bar" />
                <View android:layout_width="8dp" android:layout_height="22dp" android:layout_marginStart="4dp" android:background="@drawable/bg_sev_bar" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/severityLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sev3_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Seviye 3/4 · Homurdanan" />

                <TextView
                    android:id="@+id/severityDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="94 km/sa · sınır 82 · +12 km/sa" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Alt çubuk (navigasyon) ============ -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/remainingText"
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                tools:text="176 km · 1 sa 58 dk" />

            <TextView
                android:id="@+id/etaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:text="Varış 14:35 · 6 radar kaldı" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stopButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="24dp"
            android:text="Bitir"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/stop_red"
            app:cornerRadius="26dp" />
    </LinearLayout>

    <!-- ============ Alt sayfa: son hedefler / rota önizleme ============ -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/sheetTitle"
                style="@style/Text.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textSize="24sp"
                tools:text="Bolu" />

            <LinearLayout
                android:id="@+id/sheetEtaRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheetEta"
                    style="@style/Text.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/link"
                    android:textSize="22sp"
                    tools:text="2 sa 10 dk" />

                <TextView
                    android:id="@+id/sheetDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/space_grotesk"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp"
                    tools:text="191 km · OSRM" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sheetChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipRadars"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_chip_radar"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/chip_radar_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="7 radar" />

                <TextView
                    android:id="@+id/chipCorridors"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_corridor"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/chip_corridor_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="2 hız koridoru" />
            </LinearLayout>

            <TextView
                android:id="@+id/noteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/warning_text"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/listHeader"
            style="@style/Text.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"
            android:text="ROTA ÜZERİNDEKİ RADARLAR" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/hazardScroll"
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <LinearLayout
                android:id="@+id/hazardList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp" />
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/sheetButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bar"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="110dp"
                android:layout_height="54dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/close"
                android:textColor="@color/text_soft"
                android:textSize="16sp"
                app:cornerRadius="27dp"
                app:strokeColor="@color/border_strong" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/start_navigation"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand"
                app:cornerRadius="27dp"
                app:icon="@drawable/ic_navigation"
                app:iconGravity="textStart"
                app:iconTint="@color/text" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Gemini Live paneli ============ -->
    <LinearLayout
        android:id="@+id/assistantPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="250dp"
        android:background="@drawable/bg_sheet"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_status_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <View
                android:id="@+id/liveDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot_live" />

            <TextView
                android:id="@+id/assistantStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Gemini Live · Sert argo · Konuşuyor" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/conversationScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/userBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_bubble_user"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sen"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/userText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="280dp"
                        android:textColor="@color/text"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aiBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_bubble_ai"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gemini"
                        android:textColor="@color/bubble_ai_label"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/aiText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="300dp"
                        android:textColor="@color/text"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/suggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/suggestion1"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_outline"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Sıradaki radar nerede?"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/suggestion2"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_chip_outline"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Ne zaman varırım?"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/muteButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_raised"
                android:contentDescription="Mikrofonu sessize al"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_soft" />

            <ImageButton
                android:id="@+id/assistantStop"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="28dp"
                android:background="@drawable/bg_circle_stop"
                android:contentDescription="Asistanı durdur"
                android:src="@drawable/ic_close"
                app:tint="@color/text" />

            <ImageButton
                android:id="@+id/assistantHide"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_raised"
                android:contentDescription="Paneli küçült"
                android:src="@drawable/ic_zoom_out"
                app:tint="@color/text_soft" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/brand"
        android:visibility="gone" />
</FrameLayout>
